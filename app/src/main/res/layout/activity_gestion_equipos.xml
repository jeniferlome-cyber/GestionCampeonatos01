<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnVolver"
            android:contentDescription="Volver"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#1565C0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Gestión de Equipos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222" />

    </LinearLayout>

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Equipos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Administra los equipos"
        android:textSize="14sp"
        android:textColor="#777777" />

    <!-- Botón agregar -->
    <Button
        android:id="@+id/btnAgregarEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="+ Agregar equipo"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtSinEquipos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Todavía no hay equipos. Agrega el primero."
        android:textColor="#666666"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Lista de equipos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEquipos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp" />

</LinearLayout>
